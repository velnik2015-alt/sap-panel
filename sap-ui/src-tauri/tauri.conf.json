{
  "productName": "sap-ui",
  "version": "0.1.0",
  "identifier": "com.sap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
"windows": [
  {
    "title": "SAP PANEL",
    "width": 360,
    "height": 500,
    "resizable": true,
    "minWidth": 300,
    "minHeight": 400,
    "maxWidth": 500,
    "maxHeight": 700,
    "decorations": false,
    "transparent": true,
    "alwaysOnTop": true
  }
],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
